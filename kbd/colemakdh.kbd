(defsrc
  esc  f1   f2   f3
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defcfg
  danger-enable-cmd yes
  process-unmapped-keys no
)

(deflayer colemakdh
  caps  @myf1 @myf2 @myf3
  grv   1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab   q     w     f     p     b     j     l     u     y     ;     [     ]     \
  @leader  a     r     s     t     g     m     n     e     i     o     '     ret
  @myshift  x     c     d     v     z     k     h     ,     .     /     rsft
  lctl lmet  lalt           spc            ralt rmet rctl
)

(defalias leader (tap-hold-release 100 100 esc lmet))
(defalias myshift (tap-hold-release 100 100 caps lsft))
(defalias
  myf1 (tap-hold 200 200 f1 mute)
  myf2 (tap-hold 200 200 f2 vold)
  myf3 (tap-hold 200 200 f3 volu)
)
